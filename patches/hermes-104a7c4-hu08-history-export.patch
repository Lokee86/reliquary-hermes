+    HISTORY_EXPORT_VERSION = 1
+
+    def export_history(self, session_id: str, *, profile_id: str, max_messages: int = 128) -> dict[str, Any]:
+        """Return an owner-scoped, bounded, provider-redacted transcript copy for explicit history import.
+
+        This read API never changes or resumes the source session. It supports only unambiguous top-level
+        sessions whose current display transcript is complete within the caller's bound. Compression and
+        copied branches require lineage-aware aggregation and are unavailable in v1.
+        """
+        def unavailable(reason: str) -> dict[str, Any]:
+            return {"status": "unavailable", "reason": reason, "profile_id": profile_id,
+                    "session_id": session_id, "started_at": None, "messages": []}
+
+        if not isinstance(session_id, str) or not session_id.strip():
+            return unavailable("history_session_unavailable")
+        if type(max_messages) is not int or not 1 <= max_messages <= 128:
+            return unavailable("history_unsupported")
+        bound = max_messages
+        try:
+            owner = self._own_profile_name()
+            if not owner or profile_id != owner:
+                return unavailable("history_session_unavailable")
+            session = self.get_session(session_id)
+            if not session or session.get("profile_name") != owner:
+                return unavailable("history_session_unavailable")
+            if session.get("hidden") or session.get("archived"):
+                return unavailable("history_session_unavailable")
+            if session.get("provenance_restored") or session.get("source") == "import":
+                return unavailable("history_session_unavailable")
+            if session.get("source") == "tool":
+                return unavailable("history_unsupported")
+            from hermes_state_local_migration import NOT_CLIENT_LABELS
+            source = str(session.get("source") or "").strip()
+            if not source or source in NOT_CLIENT_LABELS:
+                return unavailable("history_unsupported")
+            from hermes_state_sessions import _parse_model_config
+            config = _parse_model_config(session.get("model_config"))
+            if (session.get("_branched_from") or config.get("_branched_from") or config.get("_delegate_from")):
+                return unavailable("history_unsupported")
+            if session.get("parent_session_id") or session.get("end_reason") in {"compression", "branched"}:
+                return unavailable("history_unsupported")
+            from hermes_state_mutation_binding import BINDING_PREFIX
+            if self._read_one("SELECT 1 FROM state_meta WHERE key = ?", (BINDING_PREFIX + session_id,)):
+                return unavailable("history_session_unavailable")
+
+            # Include compacted display rows (the canonical visible history), exclude rewind/inactive rows,
+            # and ask for one beyond the hard ceiling so truncation is never reported as success.
+            rows = self.get_messages(session_id, include_compacted=True, limit=bound + 1)
+            if len(rows) > bound:
+                return unavailable("history_too_large")
+            if not rows:
+                return unavailable("history_identity_unavailable")
+            normalized = []
+            seen_uids = set()
+            import math
+
+            def contains_data_url(value):
+                if isinstance(value, str):
+                    return "data:" in value.lower()
+                if isinstance(value, dict):
+                    return any(contains_data_url(v) for v in value.values())
+                if isinstance(value, (list, tuple)):
+                    return any(contains_data_url(v) for v in value)
+                return False
+
+            for row in rows:
+                uid = row.get("message_uid")
+                stamp = row.get("timestamp")
+                role = row.get("role")
+                if (not isinstance(uid, str) or not uid.strip() or uid in seen_uids
+                        or not isinstance(stamp, (int, float)) or not math.isfinite(stamp)
+                        or role not in {"user", "assistant", "tool"}):
+                    return unavailable("history_identity_unavailable")
+                if row.get("_compressed_summary") or row.get("absorbed_message_uids"):
+                    return unavailable("history_unsupported")
+                if not isinstance(row.get("content"), str):
+                    return unavailable("history_unsupported")
+                seen_uids.add(uid)
+                # Keep the whole logical row (including API-content and display sidecars) for byte
+                # accounting and secret learning; drop physical row/session IDs and visibility state.
+                item = {key: value for key, value in row.items() if key not in {
+                    "id", "session_id", "active", "compacted", "display_order", "observed",
+                    "display_identity",
+                }}
+                if contains_data_url(item):
+                    return unavailable("history_unsupported")
+                normalized.append(item)
+
+            try:
+                transcript_bytes = len(json.dumps(
+                    normalized, ensure_ascii=False, allow_nan=False, separators=(",", ":")
+                ).encode("utf-8"))
+            except (TypeError, ValueError, UnicodeError, RecursionError):
+                return unavailable("history_unsupported")
+            if transcript_bytes > _HISTORY_EXPORT_MAX_BYTES:
+                return unavailable("history_too_large")
+
+            # Match the installed MemoryManager's whole-transcript provider egress path exactly. If that
+            # shared redactor cannot run, raw history must never fall through as a successful export.
+            from agent.memory_manager import _redact_for_provider
+            redacted = _redact_for_provider(normalized)
+            latest = self.get_session(session_id)
+            if (not latest or latest.get("profile_name") != owner or latest.get("archived")
+                    or latest.get("hidden") or latest.get("provenance_restored") != session.get("provenance_restored")
+                    or latest.get("source") != session.get("source")
+                    or latest.get("model_config") != session.get("model_config")
+                    or latest.get("parent_session_id") != session.get("parent_session_id")
+                    or latest.get("end_reason") != session.get("end_reason")
+                    or latest.get("message_count") != session.get("message_count")
+                    or latest.get("transcript_revision") != session.get("transcript_revision")):
+                return unavailable("history_session_unavailable")
+            if not isinstance(redacted, list) or len(redacted) != len(normalized) or any(
+                not isinstance(row, dict) or row.get("message_uid") != original["message_uid"]
+                or row.get("timestamp") != original["timestamp"]
+                for row, original in zip(redacted, normalized)
+            ):
+                return unavailable("history_identity_unavailable")
+            # The provider path scrubs full rows as one transcript so a secret detected in one row is
+            # masked wherever it repeats. Only canonical visible fields leave this adapter; display
+            # sidecars (including withheld prompt metadata), reasoning, and storage identity never do.
+            exported = [{key: row[key] for key in ("message_uid", "timestamp", "role", "content")} for row in redacted]
+            return {"status": "ready", "reason": None, "profile_id": owner,
+                    "session_id": session_id, "started_at": session.get("started_at"),
+                    "messages": exported}
+        except Exception:
+            return unavailable("history_identity_unavailable")
+
