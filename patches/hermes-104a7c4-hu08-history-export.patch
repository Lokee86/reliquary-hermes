+def test_export_stops_oversized_transcript_before_redaction(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    monkeypatch.setattr("agent.memory_manager._redact_for_provider", lambda _messages: pytest.fail("redactor must not see oversized input"))
+    try:
+        db.create_session("huge", "cli")
+        db.append_message("huge", "user", "x" * (256 * 1024 + 1))
+        assert db.export_history("huge", profile_id="default")["reason"] == "history_too_large"
+        db.create_session("huge-sidecar", "cli")
+        db.append_message("huge-sidecar", "user", "short visible text", api_content="x" * (256 * 1024 + 1))
+        assert db.export_history("huge-sidecar", profile_id="default")["reason"] == "history_too_large"
+    finally:
+        db.close()
