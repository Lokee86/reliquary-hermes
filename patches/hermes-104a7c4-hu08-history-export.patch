+def test_export_rejects_nontext_inline_data_and_noninteger_message_bounds(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.create_session("nontext", "cli")
+        db.append_message("nontext", "user", [{"type": "text", "text": "hello"}])
+        assert db.export_history("nontext", profile_id="default")["reason"] == "history_unsupported"
+
+        db.create_session("inline", "cli")
+        db.append_message("inline", "user", "data:image/png;base64,AAAA")
+        assert db.export_history("inline", profile_id="default")["reason"] == "history_unsupported"
+        assert db.export_history("inline", profile_id="default", max_messages=1.0)["reason"] == "history_unsupported"
+        assert db.export_history("inline", profile_id="default", max_messages=True)["reason"] == "history_unsupported"
+    finally:
+        db.close()
