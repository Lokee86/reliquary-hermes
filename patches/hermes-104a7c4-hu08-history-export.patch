diff --git a/tests/hermes_state/test_hu08_history_export.py b/tests/hermes_state/test_hu08_history_export.py
new file mode 100644
index 00000000000..7320702403c
--- /dev/null
+++ b/tests/hermes_state/test_hu08_history_export.py
@@ -0,0 +1,236 @@
+import pytest
+
+from hermes_state import SessionDB
+
+
+def _db(tmp_path, monkeypatch):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    monkeypatch.setattr(db, "_own_profile_name", lambda: "default")
+    return db
+
+
+def test_export_is_owner_scoped_redacted_and_preserves_message_identity(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.create_session("old", "cli")
+        db.append_message("old", "user", "sensitive input", timestamp=1000)
+        row = db.get_messages("old")[0]
+        seen = []
+
+        def redactor(messages):
+            seen.extend(messages)
+            return [{**message, "content": "[redacted]"} for message in messages]
+
+        monkeypatch.setattr("agent.memory_manager._redact_for_provider", redactor)
+        result = db.export_history("old", profile_id="default")
+        assert result["status"] == "ready"
+        assert result["reason"] is None
+        assert result["messages"][0]["message_uid"] == row["message_uid"]
+        assert result["messages"][0]["timestamp"] == 1000.0
+        assert result["messages"][0]["content"] == "[redacted]"
+        assert "session_id" not in result["messages"][0] and "id" not in result["messages"][0]
+        assert seen[0]["message_uid"] == row["message_uid"]
+        assert db.export_history("old", profile_id="other")["reason"] == "history_session_unavailable"
+    finally:
+        db.close()
+
+
+def test_export_rejects_copied_branches_and_oversize(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.create_session("root", "cli")
+        db.append_message("root", "user", "root")
+        db.create_session("branch", "cli", parent_session_id="root")
+        db.append_message("branch", "user", "copied")
+        assert db.export_history("branch", profile_id="default")["reason"] == "history_unsupported"
+
+        db.create_session("large", "cli")
+        db.append_messages_batch("large", [{"role": "user", "content": str(i)} for i in range(129)])
+        assert db.export_history("large", profile_id="default")["reason"] == "history_too_large"
+    finally:
+        db.close()
+
+
+def test_export_rejects_missing_original_message_identity(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.create_session("legacy", "cli")
+        db.append_message("legacy", "user", "legacy")
+        db._conn.execute("UPDATE messages SET message_uid = NULL WHERE session_id = ?", ("legacy",))
+        assert db.export_history("legacy", profile_id="default")["reason"] == "history_identity_unavailable"
+    finally:
+        db.close()
+
+
+def test_capture_eligibility_uses_native_marker_and_fails_closed_for_legacy(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.create_session("native", "cli")
+        native = db.get_session("native")
+        cutoff = native["provenance_created_at"] - 1
+        assert db.is_session_eligible_for_capture("native", profile_id="default", enrollment_cutoff=cutoff)
+        assert not db.is_session_eligible_for_capture("native", profile_id="other", enrollment_cutoff=cutoff)
+        assert not db.is_session_eligible_for_capture("native", profile_id="default", enrollment_cutoff=native["provenance_created_at"])
+        db._conn.execute("UPDATE sessions SET provenance_created_at = NULL, provenance_root_session_id = NULL WHERE id = ?", ("native",))
+        assert not db.is_session_eligible_for_capture("native", profile_id="default", enrollment_cutoff=cutoff)
+    finally:
+        db.close()
+
+
+def test_restore_like_upsert_cannot_claim_native_creation_marker(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.create_session("restored", "cli")
+        db._conn.execute("UPDATE sessions SET provenance_created_at = NULL, provenance_root_session_id = NULL WHERE id = ?", ("restored",))
+        db.create_session("restored", "cli")  # first resume/upsert after restore
+        restored = db.get_session("restored")
+        assert restored["provenance_created_at"] is None
+        assert restored["provenance_root_session_id"] is None
+        assert not db.is_session_eligible_for_capture("restored", profile_id="default", enrollment_cutoff=0)
+    finally:
+        db.close()
+
+
+def test_legacy_durable_history_remains_manually_exportable(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.create_session("legacy", "cli")
+        db._conn.execute("UPDATE sessions SET provenance_created_at = NULL, provenance_root_session_id = NULL WHERE id = ?", ("legacy",))
+        db.append_message("legacy", "user", "durable old message", timestamp=1234)
+        exported = db.export_history("legacy", profile_id="default")
+        assert exported["status"] == "ready"
+        assert exported["messages"][0]["timestamp"] == 1234.0
+        assert not db.is_session_eligible_for_capture("legacy", profile_id="default", enrollment_cutoff=0)
+    finally:
+        db.close()
+
+
+def test_unknown_placeholder_does_not_mint_native_creation_provenance(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.ensure_session("placeholder", source="unknown")
+        db.create_session("placeholder", source="cli")
+        row = db.get_session("placeholder")
+        assert row["provenance_created_at"] is None
+        assert not db.is_session_eligible_for_capture("placeholder", profile_id="default", enrollment_cutoff=0)
+    finally:
+        db.close()
+
+
+def test_export_redacts_across_rows_then_projects_only_visible_fields(tmp_path, monkeypatch):
+    secret = "sk-proj-abc123def456ghi789jkl012"
+    db = _db(tmp_path, monkeypatch)
+    monkeypatch.setattr("agent.redact._REDACT_ENABLED", True)
+    try:
+        db.create_session("redact", "cli")
+        db.append_message("redact", "tool", f"config key={secret}")
+        db.append_message("redact", "assistant", f"I found {secret}", display_metadata={"withheld_prompt": "private blocked prompt"})
+        exported = db.export_history("redact", profile_id="default")
+        assert exported["status"] == "ready"
+        assert secret not in repr(exported)
+        assert all(set(message) == {"message_uid", "timestamp", "role", "content"} for message in exported["messages"])
+        assert "private blocked prompt" not in repr(exported)
+    finally:
+        db.close()
+
+
+def test_export_rejects_compressed_summary_that_loses_absorbed_row_identities(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.create_session("compressed", "cli")
+        db.append_message("compressed", "user", "summary", _compressed_summary=True)
+        assert db.export_history("compressed", profile_id="default")["reason"] == "history_unsupported"
+    finally:
+        db.close()
+
+
+def test_independent_reset_gets_its_own_native_creation_provenance(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.create_session("parent", "cli")
+        cutoff = db.get_session("parent")["provenance_created_at"]
+        db.create_session("reset", "cli", parent_session_id="parent", model_config={"_reset_from": "parent"})
+        reset = db.get_session("reset")
+        assert reset["provenance_root_session_id"] == "reset"
+        assert reset["provenance_created_at"] >= cutoff
+        assert db.is_session_eligible_for_capture("reset", profile_id="default", enrollment_cutoff=cutoff)
+    finally:
+        db.close()
+
+
+def test_import_without_original_times_is_marked_restored_and_stays_blocked_after_resume(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        result = db.import_sessions([{"id": "restored", "source": "cli", "messages": [
+            {"role": "user", "content": "payload omitted original UID and timestamp"}
+        ]}])
+        assert result["ok"] and result["imported"] == 1
+        db._conn.execute("UPDATE sessions SET profile_name = 'default' WHERE id = 'restored'")
+        session = db.get_session("restored")
+        message = db.get_messages("restored")[0]
+        assert session["provenance_restored"] == 1
+        assert message["message_uid"] and message["timestamp"]
+        db.create_session("restored", "cli")  # resume is an upsert, not a new native conversation
+        assert db.get_session("restored")["provenance_restored"] == 1
+        assert not db.is_session_eligible_for_capture("restored", profile_id="default", enrollment_cutoff=0)
+        assert db.export_history("restored", profile_id="default")["reason"] == "history_session_unavailable"
+    finally:
+        db.close()
+
+
+def test_prepatch_history_control_binding_blocks_ambiguous_restored_manual_export(tmp_path, monkeypatch):
+    from hermes_state_mutation_binding import BINDING_PREFIX
+
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.create_session("bound-import", "cli")
+        db.append_message("bound-import", "user", "resume me")
+        db._conn.execute("UPDATE sessions SET provenance_created_at = NULL, provenance_root_session_id = NULL WHERE id = ?", ("bound-import",))
+        db._conn.execute("INSERT INTO state_meta(key, value) VALUES(?, ?)", (BINDING_PREFIX + "bound-import", "[\"default\",\"auth:v1:[]\"]"))
+        db.create_session("bound-import", "cli")
+        assert db.export_history("bound-import", profile_id="default")["reason"] == "history_session_unavailable"
+    finally:
+        db.close()
+
+
+def test_export_rejects_detached_branch_and_delegate_markers(tmp_path, monkeypatch):
+    db = _db(tmp_path, monkeypatch)
+    try:
+        db.create_session("detached-branch", "cli", model_config={"_branched_from": "old-parent"})
+        db.append_message("detached-branch", "user", "copied payload")
+        db.create_session("detached-delegate", "cli", model_config={"_delegate_from": "coordinator"})
+        db.append_message("detached-delegate", "user", "subagent payload")
+        assert db.export_history("detached-branch", profile_id="default")["reason"] == "history_unsupported"
+        assert db.export_history("detached-delegate", profile_id="default")["reason"] == "history_unsupported"
+    finally:
+        db.close()
