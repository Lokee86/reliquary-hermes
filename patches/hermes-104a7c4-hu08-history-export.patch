+    def is_session_eligible_for_capture(
+        self, session_id: str, *, profile_id: str, enrollment_cutoff: float
+    ) -> bool:
+        """Fail-closed new-session admission using native original-creation provenance.
+
+        ``started_at`` is descriptive and can be copied from portable history; it is never used as
+        proof of a newly created conversation. Legacy rows missing the marker remain ineligible.
+        """
+        import math
+        try:
+            cutoff = float(enrollment_cutoff)
+            if not math.isfinite(cutoff):
+                return False
+            owner = self._own_profile_name()
+            if not owner or owner != profile_id:
+                return False
+            row = self.get_session(session_id)
+            if (not row or row.get("profile_name") != owner or row.get("archived") or row.get("hidden")
+                    or row.get("provenance_restored")):
+                return False
+            created = row.get("provenance_created_at")
+            root_id = row.get("provenance_root_session_id")
+            if not isinstance(created, (int, float)) or not math.isfinite(created) or created <= cutoff:
+                return False
+            if not isinstance(root_id, str) or not root_id:
+                return False
+            root = self.get_session(root_id)
+            return bool(root and root.get("profile_name") == owner
+                        and root.get("provenance_root_session_id") == root_id
+                        and root.get("provenance_created_at") == created
+                        and created > cutoff)
+        except Exception:
+            return False
+
