 import { httpStatusError } from './api-transport'
+
+export const MAX_PLUGIN_BINARY_BYTES = 1 << 20
+
+export function pluginBinaryBody(body: Buffer, mediaType: unknown): ArrayBuffer {
+  if (mediaType !== 'application/octet-stream' || body.length > MAX_PLUGIN_BINARY_BYTES) {
+    throw new Error('Invalid plugin binary response')
+  }
+  return Uint8Array.from(body).buffer
+}
 
